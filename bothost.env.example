# Telegram BotFather token
BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_ОТ_BOTFATHER

# HTTPS-адрес Mini App, который выдаст Bothost
MINI_APP_URL=https://ВАШ_АДРЕС_BOTHOST

# Telegram ID администратора
ADMIN_TELEGRAM_IDS=7487365755

# Постоянное хранилище Bothost
DATABASE_PATH=/app/data/bar.db
STORAGE_PATH=/app/data/storage

# Сетевые настройки
API_HOST=0.0.0.0
API_PORT=8080

# Оставьте пустым, если сервер Bothost напрямую подключается к Telegram
BOT_PROXY=
